# ============================================================
# USYTask — Environment Variables Template
# Copia este archivo a .env.local y rellena los valores correspondientes.
# ============================================================

# Supabase Backend Configuration
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica_aqui

# Supabase Service Role Key (SOLO servidor — bypassa RLS)
# Encuéntrala en: Supabase Dashboard → Settings → API → service_role
# NUNCA exponer en el cliente ni en variables NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_aqui

# Web Push (VAPID) Configuration
# Para generar un nuevo par de claves VAPID ejecuta en la consola:
#   npm run generate:vapid
# o bien:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu_clave_vapid_publica_aqui
VAPID_PRIVATE_KEY=tu_clave_vapid_privada_aqui
VAPID_SUBJECT=mailto:soporte@usyatask.com

# Cron Security
# Protege el endpoint /api/cron/check-reminders de accesos no autorizados.
# Genera un token seguro: openssl rand -base64 32
CRON_SECRET=tu_cron_secret_aqui
